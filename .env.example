# V4 runtime defaults. Keep HYBRID_HUMAN disabled until shadow gates pass.
BROTATO_V4_HOST=127.0.0.1
BROTATO_V4_PORT=4242
BROTATO_V4_OUTPUT_DIR=models\version_3
BROTATO_V4_AUTOMATE_MENUS=1
BROTATO_V4_SAFETY_SHIELD=0
BROTATO_V4_CONTROL_HZ=24
BROTATO_V4_RECORDER_HZ=60
BROTATO_V4_POLICY_MODE=HANDCRAFTED
BROTATO_V4_BUILD_POLICY_MODE=HANDCRAFTED

# Set these only for offline/shadow evaluation.
